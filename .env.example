# Public build configuration. Deployment writes real values to .deployment/public.env.
# Leave unset for local-only development. API URL excludes /v1.
EXPO_PUBLIC_API_URL=https://YOUR_API.execute-api.ap-southeast-5.amazonaws.com
EXPO_PUBLIC_COGNITO_DOMAIN=YOUR_DOMAIN.auth.ap-southeast-5.amazoncognito.com
EXPO_PUBLIC_USER_POOL_ID=ap-southeast-5_YOUR_POOL
EXPO_PUBLIC_WEB_CLIENT_ID=YOUR_WEB_CLIENT
EXPO_PUBLIC_NATIVE_CLIENT_ID=YOUR_NATIVE_CLIENT
EXPO_PUBLIC_WEB_URL=https://YOUR_DISTRIBUTION.cloudfront.net
