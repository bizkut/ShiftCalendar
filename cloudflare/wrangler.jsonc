{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shiftcalendar-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/v1", "/v1/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "shiftcalendar-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations",
    "remote": false
  }],
  "vars": {
    "ACCESS_ISSUER": "https://unconfigured.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "unconfigured",
    "APP_ORIGIN": "http://localhost:8787"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
