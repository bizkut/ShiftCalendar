{
  "name": "shiftcalendar",
  "version": "2.4.2",
  "main": "./index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:pilot": "node --test scripts/pilot.test.mjs scripts/smoke-aws.test.mjs scripts/cloudfront-plan.test.mjs",
    "build:web": "expo export --platform web",
    "cf:build": "node scripts/build-cloudflare.mjs",
    "cf:test": "npm --prefix cloudflare test",
    "cf:typecheck": "npm --prefix cloudflare run typecheck",
    "cf:dev": "npm --prefix cloudflare run dev",
    "cf:smoke:local": "node scripts/smoke-cloudflare-local.mjs",
    "cf:prepare": "npm run cf:build && npm --prefix cloudflare run dry-run",
    "aws:prepare": "node scripts/deploy-aws.mjs prepare",
    "aws:deploy": "node scripts/deploy-aws.mjs deploy",
    "aws:smoke": "node scripts/smoke-aws.mjs"
  },
  "dependencies": {
    "@aws-amplify/react-native": "^1.3.3",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "aws-amplify": "^6.20.0",
    "babel-preset-expo": "^55.0.10",
    "date-fns": "^4.1.0",
    "expo": "~55.0.11",
    "expo-constants": "^55.0.7",
    "expo-document-picker": "~55.0.11",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.11",
    "expo-linking": "~55.0.11",
    "expo-navigation-bar": "~55.0.10",
    "expo-notifications": "~55.0.16",
    "expo-print": "~55.0.11",
    "expo-router": "~55.0.10",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.16",
    "expo-splash-screen": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.13",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "^0.83.4",
    "react-native-android-widget": "^0.20.1",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
